<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Row: Date & Weather Status -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/widget_weather"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:text="الأربعاء ، 22 يوليو"
            android:textColor="#E0F2F1"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="start|center_vertical"
            android:textAlignment="viewStart"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="مشمس · 26°C"
            android:textColor="#FFD54F"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="end|center_vertical"
            android:textAlignment="viewEnd"
            android:singleLine="true" />
    </RelativeLayout>

    <!-- Hero Card: Next Prayer Highlight -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_hero_card_bg"
        android:orientation="vertical"
        android:padding="10dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/widget_next_prayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الصلاة القادمة: الظهر (12:31 م)"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="متبقي 1 س و 38 د"
            android:textColor="#B2DFDB"
            android:textSize="12sp"
            android:gravity="center"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Bottom Row: Upcoming Prayer Timeline Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_prayer_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_pill_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="الظهر 12:31"
            android:textColor="#E0F2F1"
            android:textSize="10sp"
            android:gravity="center"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_prayer_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_pill_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="العصر 04:04"
            android:textColor="#E0F2F1"
            android:textSize="10sp"
            android:gravity="center"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_prayer_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_pill_bg"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="المغرب 07:22"
            android:textColor="#E0F2F1"
            android:textSize="10sp"
            android:gravity="center"
            android:singleLine="true" />
    </LinearLayout>

</LinearLayout>
